generator client {
  provider   = "prisma-client"
  output     = "../src/generated/"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  image     String?
  location  String?
  createdAt DateTime  @default(now())
  dob       DateTime?
  booked    Booked[]
}

model Company {
  id          Int          @id @default(autoincrement())
  name        String
  key         String       @unique
  password    String
  createdAt   DateTime     @default(now())
  logo        String?
  departments Department[]
}

model Department {
  id        Int            @id @default(autoincrement())
  companyId Int
  name      String
  type      DepartmentType @default(General)
  createdAt DateTime       @default(now())
  price     Int            @default(100)
  company   Company        @relation(fields: [companyId], references: [id])
  schedules Schedules[]

  @@index([companyId])
}

model Schedules {
  id           Int         @id @default(autoincrement())
  departmentId Int
  date         DateTime    @db.Date
  startTime    DateTime    @db.Time(6)
  endTime      DateTime    @db.Time(6)
  status       statusTypes @default(Available)
  booked       Booked?
  department   Department  @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
}

model Booked {
  id                Int           @id @default(autoincrement())
  userId            Int
  schedulesId       Int           @unique
  qrCode            String
  status            BookingStatus @default(Upcoming)
  createdAt         DateTime      @default(now())
  bookingPrice      Int?
  platformFee       Int?
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  totalAmount       Int?
  schedules         Schedules     @relation(fields: [schedulesId], references: [id])
  user              User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([schedulesId])
}

enum DepartmentType {
  General
  Health
}

enum BookingStatus {
  Upcoming
  Attended
  Missed
}

enum statusTypes {
  Available
  Locked
  Booked
}
